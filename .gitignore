# Byte-compiled / optimized files (github/gitignore Python template)
__pycache__/
*.py[codz]
*$py.class

# Build artifacts (regenerated by: python -m PyInstaller copy-tree.spec --noconfirm)
build/
dist/

# Unit test / coverage artifacts
.pytest_cache/
.coverage
htmlcov/
test_runtime*/

# Environments
.env
.venv/
venv/
env/
ENV/

# Internal docs (kept out of the repo)
/docs/

# AI assistant local context only — AGENTS.md itself is tracked per the agents.md spec
.claude/settings.local.json
.zcode/

# IDE
.vs/
.vscode/
.idea/

# Skill execution workspaces (SDD scratch + linked worktrees)
.superpowers/
.worktrees/

# OS
.DS_Store
Thumbs.db
desktop.ini

# GitHub: keep only the workflow files.
# gitignore(5): a file cannot be re-included while a parent directory is
# excluded, so un-ignore each level down to the target file.
.github/*
!.github/workflows/
.github/workflows/*
!.github/workflows/build.yml
